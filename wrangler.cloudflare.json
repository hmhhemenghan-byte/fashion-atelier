{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nera-atelier",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nera-atelier-prod",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "replace-with-nera-r2-bucket"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_PROVIDER": "cloudflare-access",
    "TEAM_DOMAIN": "https://replace-with-team.cloudflareaccess.com",
    "POLICY_AUD": "replace-with-access-audience-tag"
  },
  "observability": {
    "enabled": true
  }
}
